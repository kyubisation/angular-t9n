{
  "name": "angular-t9n",
  "version": "21.0.0",
  "description": "A translation tool for Angular i18n",
  "bin": {
    "ng-t9n": "./bin/cli.js"
  },
  "keywords": [
    "angular",
    "i18n",
    "xliff",
    "xlf",
    "xlf2",
    "translation",
    "t9n"
  ],
  "scripts": {
    "prepare": "husky",
    "ng": "ng",
    "start": "ng serve",
    "clean": "rimraf --glob coverage \"{bin,builders,schematics,server}/**/index.{js,d.ts}\"",
    "build": "npm run build:ng && npm run build:node",
    "build:ng": "ng build --configuration production",
    "build:node": "rollup --config rollup.config.mjs",
    "format": "prettier --ignore-unknown --write \"**/*\"",
    "test": "npm run test:node",
    "test:node": "node --import tsx --test '{bin,builders,server}/**/*.spec.ts'",
    "lint": "ng lint",
    "xi18n:xlf": "ng extract-i18n -c xlf",
    "xi18n:xlf2": "ng extract-i18n",
    "xi18n": "npm run xi18n:xlf && npm run xi18n:xlf2",
    "t9n:xlf": "ng run angular-t9n:t9n -c xlf",
    "t9n:xlf2": "ng run angular-t9n:t9n",
    "release": "commit-and-tag-version --tag-prefix=\"\""
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.11.1"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11.6.2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kyubisation/angular-t9n.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/kyubisation/angular-t9n/issues"
  },
  "files": [
    "bin/*.js",
    "builders/builders.json",
    "builders/*/*.{js,json}",
    "schematics/collection.json",
    "schematics/*/*.{js,json}",
    "server/client/*",
    "server/index.js"
  ],
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/platform-ws": "^11.1.9",
    "@nestjs/serve-static": "^5.0.4",
    "@nestjs/websockets": "^11.1.9",
    "@xmldom/xmldom": "^0.9.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "js-levenshtein": "^1.1.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.1",
    "@angular-eslint/eslint-plugin": "^21.0.1",
    "@angular-eslint/eslint-plugin-template": "^21.0.1",
    "@angular-eslint/schematics": "^21.0.1",
    "@angular-eslint/template-parser": "^21.0.1",
    "@angular/animations": "^21.0.3",
    "@angular/build": "^21.0.2",
    "@angular/cdk": "^21.0.2",
    "@angular/cli": "^21.0.2",
    "@angular/common": "^21.0.3",
    "@angular/compiler": "^21.0.3",
    "@angular/compiler-cli": "^21.0.3",
    "@angular/core": "^21.0.3",
    "@angular/forms": "^21.0.3",
    "@angular/language-service": "^21.0.3",
    "@angular/localize": "^21.0.3",
    "@angular/material": "^21.0.2",
    "@angular/platform-browser": "^21.0.3",
    "@angular/platform-browser-dynamic": "^21.0.3",
    "@angular/router": "^21.0.3",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.9",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/express": "^5.0.6",
    "@types/jasmine": "~5.1.13",
    "@types/js-levenshtein": "^1.1.3",
    "@types/node": "^24.10.1",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "commit-and-tag-version": "^12.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "rollup": "^4.53.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "xlsx": "^0.18.5",
    "zone.js": "~0.15.0"
  },
  "schematics": "./schematics/collection.json",
  "builders": "./builders/builders.json",
  "ng-add": {
    "save": "devDependencies"
  },
  "prettier": {
    "singleQuote": true,
    "endOfLine": "lf",
    "printWidth": 100
  },
  "lint-staged": {
    "*.{js,ts,css,scss,json,md,html}": [
      "prettier --write --ignore-unknown"
    ]
  }
}
