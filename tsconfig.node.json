{
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2022",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "lib": ["es2022", "dom"],
    "types": ["js-levenshtein", "node"]
  }
}
